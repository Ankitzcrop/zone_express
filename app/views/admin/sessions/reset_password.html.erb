<!DOCTYPE html>
<html>
<head>
  <title>Reset Password</title>
  <style>
    body {
      margin: 0;
      font-family: Arial;
      display: flex;
      height: 100vh;
      background: #f5f5f5;
    }

    /* LEFT SIDE */
    .left {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #f5f5f5;
      position: relative;
    }

    /* Divider line */
    .left::after {
      content: "";
      position: absolute;
      right: 0;
      top: 0;
      height: 100%;
      width: 1px;
      background: #ddd;
    }

    .left img {
      width: 320px;
      max-width: 90%;
      mix-blend-mode: multiply; /* white bg hide */
    }

    /* RIGHT SIDE */
    .right {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #fff;
    }

    .form-box {
      width: 360px;
      text-align: center;
    }

    h2 {
      font-weight: 700;
      margin-bottom: 10px;
    }

    p {
      font-size: 14px;
      color: #777;
      margin-bottom: 25px;
    }

    /* INPUTS */
    input {
      width: 100%;
      padding: 14px;
      margin-top: 15px;
      border-radius: 10px;
      border: 1px solid #ddd;
      font-size: 14px;
      outline: none;
      transition: 0.2s;
    }

    input:focus {
      border-color: #ffd400;
      box-shadow: 0 0 4px rgba(255,212,0,0.6);
    }

    /* BUTTON */
    .submit-btn {
      width: 100%;
      padding: 14px;
      background: #ffd400;
      border: none;
      margin-top: 25px;
      border-radius: 10px;
      font-weight: bold;
      cursor: pointer;
      font-size: 15px;
    }

  </style>
</head>

<body>

  <!-- LEFT -->
  <div class="left">
    <%= image_tag "Rectangle8.png" %>
  </div>

  <!-- RIGHT -->
  <div class="right">
    <div class="form-box">
      <h2>Reset Your Password</h2>
      <p>Enter your new password below</p>

      <%= form_with url: admin_update_password_path, method: :post do %>

        <%= password_field_tag :password, nil, placeholder: "New Password" %>

        <%= password_field_tag :password_confirmation, nil, placeholder: "Confirm Password" %>

        <%= submit_tag "Reset Password", class: "submit-btn" %>

      <% end %>

    </div>
  </div>

</body>
</html>

<!DOCTYPE html>
<html>
<head>
  <title>Forgot Password</title>
  <style>
    body {
      margin: 0;
      font-family: Arial;
      display: flex;
      height: 100vh;
    }

    .left {
      flex: 1;
      background: #f2f2f2;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .left img {
      width: 400px;
    }

    .right {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .form-box {
      width: 350px;
    }

    h2 {
      font-weight: bold;
    }

    p {
      font-size: 14px;
      color: #777;
    }

    input {
      width: 100%;
      padding: 12px;
      margin-top: 15px;
      border-radius: 8px;
      border: 1px solid #ddd;
    }

    .otp-btn {
      width: 100%;
      padding: 12px;
      background: #ffd400;
      border: none;
      margin-top: 20px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
    }

    .back-login {
      margin-top: 10px;
      font-size: 13px;
      text-align: center;
    }

    .back-login a {
      text-decoration: none;
      color: black;
      font-weight: bold;
    }
  </style>
</head>

<body>

  <!-- LEFT IMAGE -->
  <div class="left">
    <%= image_tag "delivery_boy.png" %> <!-- PDF ki jagah PNG/JPG use karo -->
  </div>

  <!-- RIGHT FORM -->
  <div class="right">
    <div class="form-box">
      <h2>Forgot Password?</h2>
      <p>Enter your registered mobile number to receive an OTP</p>

      <%= form_with url: admin_send_otp_path, method: :post do %>

        <%= text_field_tag :phone_number, nil, placeholder: "Registered Mobile Number" %>

        <%= submit_tag "Get OTP", class: "otp-btn" %>

      <% end %>
    </div>
  </div>

</body>
</html>

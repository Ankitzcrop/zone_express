<div class="dashboard-container">

  <!-- Sidebar -->
  <%= render 'shared/sidebar' %>

  <!-- Main -->
  <main class="main-content">

    <!-- Header -->
    <%= render 'shared/header' %>

    <!-- TOP CARDS -->
    <div class="cards">
      <div class="stat-card">
        <p>Net Revenue</p>
        <h2>₹123,000.00</h2>
      </div>
      <div class="stat-card">
        <p>Total Refund</p>
        <h2>₹50,000.00</h2>
      </div>
      <div class="stat-card">
        <p>Total Order</p>
        <h2>15,045</h2>
      </div>
      <div class="stat-card">
        <p>Total Delivered Items</p>
        <h2>1,547</h2>
      </div>
      <div class="stat-card">
        <p>Total Users</p>
        <h2>5,468</h2>
      </div>
    </div>

    <!-- CHART SECTION -->
    <div class="container">

      <!-- TOP -->
      <div class="grid">
        <div class="chart-card">
          <div class="card-header">
            <h4>Net Revenue</h4>
            <select><option>Yearly</option></select>
          </div>
          <canvas id="revenueChart"></canvas>
        </div>

        <div class="chart-card">
          <div class="card-header">
            <h4>Total Refund</h4>
            <select><option>Yearly</option></select>
          </div>
          <canvas id="refundChart"></canvas>
        </div>
      </div>

      <!-- BOTTOM -->
      <div class="bottom-grid">
        <div class="chart-card">
          <div class="card-header">
            <h4>Total Delivered Items</h4>
            <select><option>Yearly</option></select>
          </div>
          <canvas id="deliveredChart"></canvas>
        </div>

        <div class="chart-card">
          <div class="card-header">
            <h4>Recent Delivered Agent</h4>
            <div>
              <button class="btn btn-outline">Add New Agent</button>
              <button class="btn btn-yellow">View All</button>
            </div>
          </div>

          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Mobile</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% 5.times do %>
              <tr>
                <td class="id">#123</td>
                <td>Cameron Williamson</td>
                <td>9644834471</td>
                <td>May 08, 2025</td>
              </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- USERS -->
    <div class="users">
      <div class="users-header">
        <h4>All Users</h4>

        <div class="users-actions">
          <select>
            <option>Most Earn</option>
          </select>

          <button class="add-btn">Add New Franchise</button>
          <button class="view-btn">View All</button>
        </div>
      </div>

      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>User</th>
            <th>Location</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Spend</th>
            <th>City</th>
            <th>⋮</th>
          </tr>
        </thead>

        <tbody>
          <% 6.times do |i| %>
          <tr>
            <td>#0<%= i+1 %></td>
            <td>John Doe</td>
            <td>India</td>
            <td>john@email.com</td>
            <td>9876543210</td>
            <td>₹12,000</td>
            <td>Indore</td>
            <td>⋮</td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const labels = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

new Chart(document.getElementById('revenueChart'), {
  type: 'line',
  data: {
    labels,
    datasets: [{
      data: [18,30,20,30,45,25,10,8,20,42,47,13],
      borderColor: '#facc15',
      tension: 0.4
    }]
  }
});

new Chart(document.getElementById('refundChart'), {
  type: 'line',
  data: {
    labels,
    datasets: [{
      data: [18,30,20,30,45,25,10,8,20,42,47,13],
      borderColor: '#ef4444',
      tension: 0.4
    }]
  }
});

new Chart(document.getElementById('deliveredChart'), {
  type: 'line',
  data: {
    labels,
    datasets: [{
      data: [0,50,55,15,12,15,10,8,20,30,12,60],
      borderColor: '#6366f1',
      borderDash: [5,5],
      tension: 0.4
    }]
  }
});
</script>

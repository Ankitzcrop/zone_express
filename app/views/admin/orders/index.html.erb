<div class="dashboard-container">

  <!-- Sidebar -->
  <%= render 'shared/sidebar' %>

  <!-- Main Content -->
  <div class="main-content">

    <!-- Header -->
    <%= render 'shared/header' %>

    <!-- Page Content -->
    <div class="content-wrapper">

      <!-- Page Heading -->
      <div class="page-header">
        <div class="header-top">
          <h3>All Order</h3>

          <div class="breadcrumb">
            <span>Home</span> / <span class="active">All Order </span>
          </div>
        </div>

        <p>You can view all orders here</p>
      </div>

      <!-- Table Card -->
      <div class="table-card">

        <!-- Table Top Bar -->
        <div class="table-header">
          <h4>All Orders</h4>

          <div class="actions">
            <div class="search-box">
              <input type="text" placeholder="Search">
              <span class="filter-icon">⚙️</span>
            </div>
          </div>
        </div>

        <!-- Table -->
        <table>
          <thead>
            <tr>
              <th><input type="checkbox"></th>
              <th>Customer Name</th>
              <th>Email</th>
              <th>Contact Number</th>
              <th>Location</th>
              <th>No of Ship</th>
              <th>Ship Location</th>
              <th>Last Order Date</th>
            </tr>
          </thead>

          <tbody>
            <% if @orders.present? %>
              <% @orders.each_with_index do |order, index| %>
                <tr>
                  <td><input type="checkbox"></td>
                  <td>#<%= index + 1 %> <%= order.customer_name %></td>
                  <td><%= order.email %></td>
                  <td><%= order.contact_number %></td>
                  <td><%= order.location %></td>
                  <td><%= order.ship_count %></td>
                  <td><%= order.ship_location %></td>
                  <td><%= order.last_order_date.strftime("%b %d, %Y") if order.last_order_date %></td>
                </tr>
              <% end %>
            <% else %>

              <!-- Dummy Row 1 -->
              <tr>
                <td><input type="checkbox"></td>
                <td>#1 Rahul Sharma</td>
                <td>rahul@gmail.com</td>
                <td>9876543210</td>
                <td>Delhi</td>
                <td>3</td>
                <td>Mumbai Port</td>
                <td>Apr 10, 2026</td>
              </tr>

              <!-- Dummy Row 2 -->
              <tr>
                <td><input type="checkbox"></td>
                <td>#2 Amit Verma</td>
                <td>amit@gmail.com</td>
                <td>9123456780</td>
                <td>Indore</td>
                <td>5</td>
                <td>Chennai Port</td>
                <td>Apr 12, 2026</td>
              </tr>

            <% end %>
          </tbody>
        </table>

      </div>
    </div>
  </div>
</div>
